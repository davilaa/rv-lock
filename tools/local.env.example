# Copy to tools/local.env (git-ignored) and fill in for your site.
# The helper scripts assume Home Assistant OS running as a Proxmox VM with the QEMU guest agent.
PVE_HOST=root@proxmox.example   # ssh target of the Proxmox host
HAOS_VMID=100                   # VM id of Home Assistant OS
PROXY_IP=192.0.2.10             # IP address of the ESPHome Bluetooth proxy
PROXY_PREFIX=bt_proxy           # entity-id prefix of the proxy's lock entities (sensor.<prefix>_lock_advert_wait)
